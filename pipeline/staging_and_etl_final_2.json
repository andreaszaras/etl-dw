					"compute": {
						"coreCount": 8,
						"computeType": "General"
					},
					"traceLevel": "Fine"
				}
			},
			{
				"name": "truncate_wrk",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "Union_SalesOrderHeader_2",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "etl_dw_1",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": "IF OBJECT_ID('wrk.ProductCategory', 'U') IS NOT NULL\n    TRUNCATE TABLE wrk.ProductCategory;\n\nIF OBJECT_ID('wrk.Customer', 'U') IS NOT NULL\n    TRUNCATE TABLE wrk.Customer;\n\nIF OBJECT_ID('wrk.ProductSubcategory', 'U') IS NOT NULL\n    TRUNCATE TABLE wrk.ProductSubcategory;\n\nIF OBJECT_ID('wrk.SalesOrderHeader', 'U') IS NOT NULL\n    TRUNCATE TABLE wrk.SalesOrderHeader;\n\nIF OBJECT_ID('wrk.SalesOrderDetail', 'U') IS NOT NULL\n    TRUNCATE TABLE wrk.SalesOrderDetail;\n\nIF OBJECT_ID('wrk.Store', 'U') IS NOT NULL\n    TRUNCATE TABLE wrk.Store;\n\nIF OBJECT_ID('wrk.SalesTerritory', 'U') IS NOT NULL\n    TRUNCATE TABLE wrk.SalesTerritory;\n\nIF OBJECT_ID('wrk.Person', 'U') IS NOT NULL\n    TRUNCATE TABLE wrk.Person;"
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "Color_Transform",
				"type": "ExecuteDataFlow",
				"dependsOn": [
					{
						"activity": "stg_to_wrk",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataflow": {
						"referenceName": "Color_Transform",
						"type": "DataFlowReference"
					},
					"compute": {
						"coreCount": 8,
						"computeType": "General"
					},
					"traceLevel": "Fine"
				}
			},
			{
				"name": "stg_to_wrk",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "truncate_wrk",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "stg_to_wrk_final_version",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"cw_items": "@pipeline().parameters.cw_items"
					}
				}
			},
			{
				"name": "DimCustomer",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "Name_and_Age_Manipulation",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "etl_dw_1",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": "TRUNCATE TABLE dw.DimCustomer;\n\nINSERT INTO dw.DimCustomer (\n    CustomerID,\n    CustomerType,\n    FirstName,\n    LastName,\n    MiddleName,\n    Age\n)\nSELECT \n    c.CustomerID,\n    CASE \n        WHEN c.PersonID IS NOT NULL THEN 'Person'\n        WHEN c.StoreID IS NOT NULL THEN 'Store'\n        ELSE 'Unknown'\n    END AS CustomerType,\n    p.First_Name,\n    p.Last_Name,\n    p.Middle_Name,\n    p.Age\nFROM wrk.Customer c\nLEFT JOIN wrk.Person p\n    ON c.PersonID = p.BusinessEntityID;\n"
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "DimDate",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "Name_and_Age_Manipulation",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "etl_dw_1",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": "TRUNCATE TABLE dw.DimDate;\n\nWITH DateCTE AS (\nSELECT CAST('2010-01-01' AS DATE) AS TheDate\nUNION ALL\nSELECT DATEADD(DAY, 1, TheDate)\nFROM DateCTE\nWHERE TheDate < '2030-12-31'\n)\nINSERT INTO dw.DimDate (\nDateKey,\nFullDate,\nDayNumberOfMonth,\nMonthNumber,\nMonthName,\nQuarterNumber,\nYearNumber\n)\nSELECT\nCAST(FORMAT(TheDate, 'yyyyMMdd') AS INT),\nTheDate,\nDAY(TheDate),\nMONTH(TheDate),\nDATENAME(MONTH, TheDate),\nDATEPART(QUARTER, TheDate),\nYEAR(TheDate)\nFROM DateCTE\nOPTION (MAXRECURSION 0);\n\n\n\n"
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			}
		],
