					"dataflow": {
						"referenceName": "Union_SalesOrderHeader_2",
						"type": "DataFlowReference"
					},
					"compute": {
						"coreCount": 8,
						"computeType": "General"
					},
					"traceLevel": "Fine"
				}
			},
			{
				"name": "Name_and_Age_Manipulation",
				"type": "ExecuteDataFlow",
				"dependsOn": [
					{
						"activity": "Color_Transform",
