							"text": "DELETE FROM dw.FactSales;\nDELETE FROM dw.DimTerritory;\n\nINSERT INTO dw.DimTerritory (\n    TerritoryID,\n    TerritoryName,\n    CountryRegionCode,\n    TerritoryGroup\n)\nSELECT\n    TerritoryID,\n    Name AS TerritoryName,\n    CountryRegionCode,\n    [Group] AS TerritoryGroup\nFROM stg.SalesTerritory;"
						}
					],
