					"scripts": [
						{
							"type": "Query",
							"text": "IF OBJECT_ID('wrk.ProductCategory', 'U') IS NOT NULL\n    TRUNCATE TABLE wrk.ProductCategory;\n\nIF OBJECT_ID('wrk.Customer', 'U') IS NOT NULL\n    TRUNCATE TABLE wrk.Customer;\n\nIF OBJECT_ID('wrk.ProductSubcategory', 'U') IS NOT NULL\n    TRUNCATE TABLE wrk.ProductSubcategory;\n\nIF OBJECT_ID('wrk.SalesOrderHeader', 'U') IS NOT NULL\n    TRUNCATE TABLE wrk.SalesOrderHeader;\n\nIF OBJECT_ID('wrk.SalesOrderDetail', 'U') IS NOT NULL\n    TRUNCATE TABLE wrk.SalesOrderDetail;\n\nIF OBJECT_ID('wrk.Store', 'U') IS NOT NULL\n    TRUNCATE TABLE wrk.Store;\n\nIF OBJECT_ID('wrk.SalesTerritory', 'U') IS NOT NULL\n    TRUNCATE TABLE wrk.SalesTerritory;\n\nIF OBJECT_ID('wrk.Person', 'U') IS NOT NULL\n    TRUNCATE TABLE wrk.Person;\n\nIF OBJECT_ID('wrk.pre_fact’, 'U') IS NOT NULL\n    TRUNCATE TABLE wrk.pre_fact;\n"
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
