						"typeProperties": {
							"scripts": [
								{
									"type": "Query",
									"text": "TRUNCATE TABLE dw.DimDate;\n\nWITH DateCTE AS (\nSELECT CAST('2010-01-01' AS DATE) AS TheDate\nUNION ALL\nSELECT DATEADD(DAY, 1, TheDate)\nFROM DateCTE\nWHERE TheDate < '2030-12-31'\n)\nINSERT INTO dw.DimDate (\nDateKey,\nFullDate,\nDayNumberOfMonth,\nMonthNumber,\nMonthName,\nQuarterNumber,\nYearNumber\n)\nSELECT\nCAST(FORMAT(TheDate, 'yyyyMMdd') AS INT),\nTheDate,\nDAY(TheDate),\nMONTH(TheDate),\nDATENAME(MONTH, TheDate),\nDATEPART(QUARTER, TheDate),\nYEAR(TheDate)\nFROM DateCTE\nOPTION (MAXRECURSION 0);\n\n\n\n"
								}
							],
							"scriptBlockExecutionTimeout": "02:00:00"
						}
