			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "AzureSqlTable34",
								"type": "DatasetReference"
							},
							"name": "Person"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "AzureSqlTable39",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "FirstName"
						},
						{
							"name": "LastName"
						},
						{
							"name": "MIddleName"
						},
						{
							"name": "AgeYears"
						}
					],
					"scriptLines": [
						"source(output(",
						"          BusinessEntityID as integer,",
						"          PersonType as string,",
						"          NameStyle as boolean,",
						"          Title as string,",
						"          Suffix as string,",
						"          EmailPromotion as integer,",
						"          AdditionalContactInfo as string,",
						"          Demographics as string,",
						"          rowguid as string,",
						"          ModifiedDate as timestamp,",
						"          FullName as string,",
						"          DateOfBirth as date",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> Person",
						"Person derive(First_Name = toString(split(trim(FullName), ' ')[1])) ~> FirstName",
						"FirstName derive(Last_Name = regexExtract(trim(toString(FullName)), '([^ ]+)$', 1)) ~> LastName",
						"LastName derive(Middle_Name = iif(     size(split(trim(toString(FullName)), ' ')) > 2,     at(split(trim(toString(FullName)), ' '), 2),     '' )) ~> MIddleName",
						"MIddleName derive(Age = toInteger(monthsBetween(currentDate(), DateOfBirth) / 12)) ~> AgeYears",
						"AgeYears sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          BusinessEntityID as integer,",
						"          PersonType as string,",
						"          NameStyle as boolean,",
						"          Title as string,",
						"          Suffix as string,",
						"          EmailPromotion as integer,",
						"          AdditionalContactInfo as string,",
						"          Demographics as string,",
						"          rowguid as string,",
						"          ModifiedDate as timestamp,",
						"          FullName as string,",
						"          DateOfBirth as date,",
						"          First_Name as string,",
						"          Last_Name as string,",
						"          Middle_Name as string,",
						"          Age as integer",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     truncate:true,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
					]
				}
			},
			"dependsOn": []
		},
