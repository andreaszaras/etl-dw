{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "AzureSqlTable13",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "DelimitedText2",
						"type": "DatasetReference"
					},
					"name": "source3"
				},
				{
					"dataset": {
						"referenceName": "DelimitedText3",
						"type": "DatasetReference"
					},
					"name": "source4"
				},
				{
					"dataset": {
						"referenceName": "DelimitedText4",
						"type": "DatasetReference"
					},
					"name": "source5"
				},
				{
					"dataset": {
						"referenceName": "DelimitedText5",
						"type": "DatasetReference"
					},
					"name": "source6"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "AzureSqlTable17",
						"type": "DatasetReference"
					},
					"name": "sink1"
				},
				{
					"dataset": {
						"referenceName": "AzureSqlTable16",
						"type": "DatasetReference"
					},
					"name": "sink2"
				}
			],
			"transformations": [
				{
					"name": "FirstName"
				},
				{
					"name": "alterRow1",
					"description": "upsertIf(true())"
				},
				{
					"name": "LastName"
				},
				{
					"name": "MiddleName"
				},
				{
					"name": "union2"
				},
				{
					"name": "union3"
				},
				{
					"name": "union4"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "age"
				}
			],
			"scriptLines": [
				"source(output(",
				"          BusinessEntityID as integer,",
				"          PersonType as string,",
				"          NameStyle as boolean,",
				"          Title as string,",
				"          Suffix as string,",
				"          EmailPromotion as integer,",
				"          AdditionalContactInfo as string,",
				"          Demographics as string,",
				"          rowguid as string,",
				"          ModifiedDate as timestamp,",
				"          FullName as string,",
				"          DateOfBirth as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source(output(",
				"          SalesOrderID as string,",
				"          SalesOrderDetailID as string,",
				"          CarrierTrackingNumber as string,",
				"          OrderQty as string,",
				"          ProductID as string,",
				"          SpecialOfferID as string,",
				"          UnitPrice as string,",
				"          UnitPriceDiscount as string,",
				"          LineTotal as string,",
				"          rowguid as string,",
				"          ModifiedDate as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source3",
				"source(output(",
				"          SalesOrderID as string,",
				"          SalesOrderDetailID as string,",
				"          CarrierTrackingNumber as string,",
				"          OrderQty as string,",
				"          ProductID as string,",
				"          SpecialOfferID as string,",
				"          UnitPrice as string,",
				"          UnitPriceDiscount as string,",
				"          LineTotal as string,",
				"          rowguid as string,",
				"          ModifiedDate as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source4",
				"source(output(",
				"          SalesOrderID as string,",
				"          SalesOrderDetailID as string,",
				"          CarrierTrackingNumber as string,",
				"          OrderQty as string,",
				"          ProductID as string,",
				"          SpecialOfferID as string,",
				"          UnitPrice as string,",
				"          UnitPriceDiscount as string,",
				"          LineTotal as string,",
				"          rowguid as string,",
				"          ModifiedDate as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source5",
				"source(output(",
				"          SalesOrderID as string,",
				"          SalesOrderDetailID as string,",
				"          CarrierTrackingNumber as string,",
				"          OrderQty as string,",
				"          ProductID as string,",
				"          SpecialOfferID as string,",
				"          UnitPrice as string,",
				"          UnitPriceDiscount as string,",
				"          LineTotal as string,",
				"          rowguid as string,",
				"          ModifiedDate as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source6",
				"source1 derive(First_Name = toString(split(trim(FullName), ' ')[1])) ~> FirstName",
				"age alterRow(insertIf(true())) ~> alterRow1",
				"FirstName derive(Last_name = regexExtract(trim(toString(FullName)), '([^ ]+)$', 1)) ~> LastName",
				"LastName derive(Midlle_Name = iif(     size(split(trim(toString(FullName)), ' ')) > 2,     at(split(trim(toString(FullName)), ' '), 2),     '' )) ~> MiddleName",
				"source3, source4 union(byName: true)~> union2",
				"union2, source5 union(byName: true)~> union3",
				"union3, source6 union(byName: true)~> union4",
				"union4 aggregate(aaa = count(1)) ~> aggregate1",
				"MiddleName derive(age_years = toInteger(monthsBetween(currentDate(), DateOfBirth) / 12)) ~> age",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink2"
			]
		}
	}
}