{
	"name": "Error_Handling",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "AzureSqlTable59",
						"type": "DatasetReference"
					},
					"name": "SOH"
				},
				{
					"dataset": {
						"referenceName": "AzureSqlTable58",
						"type": "DatasetReference"
					},
					"name": "SOD"
				},
				{
					"dataset": {
						"referenceName": "AzureSqlTable60",
						"type": "DatasetReference"
					},
					"name": "customer"
				},
				{
					"dataset": {
						"referenceName": "AzureSqlTable63",
						"type": "DatasetReference"
					},
					"name": "product"
				},
				{
					"dataset": {
						"referenceName": "AzureSqlTable64",
						"type": "DatasetReference"
					},
					"name": "date"
				},
				{
					"dataset": {
						"referenceName": "AzureSqlTable65",
						"type": "DatasetReference"
					},
					"name": "territoryu"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "AzureSqlTable61",
						"type": "DatasetReference"
					},
					"name": "sink1"
				},
				{
					"dataset": {
						"referenceName": "AzureSqlTable62",
						"type": "DatasetReference"
					},
					"name": "sink2"
				}
			],
			"transformations": [
				{
					"name": "join1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "lookup1"
				},
				{
					"name": "split1"
				},
				{
					"name": "select1"
				},
				{
					"name": "select2"
				},
				{
					"name": "joincustomer"
				},
				{
					"name": "joinprodcut"
				},
				{
					"name": "joindate"
				},
				{
					"name": "jointerritory"
				}
			],
			"scriptLines": [
				"source(output(",
				"          SalesOrderID as integer,",
				"          RevisionNumber as integer,",
				"          OrderDate as timestamp,",
				"          DueDate as timestamp,",
				"          ShipDate as timestamp,",
				"          Status as integer,",
				"          OnlineOrderFlag as boolean,",
				"          SalesOrderNumber as string,",
				"          PurchaseOrderNumber as string,",
				"          AccountNumber as string,",
				"          CustomerID as integer,",
				"          SalesPersonID as integer,",
				"          TerritoryID as integer,",
				"          BillToAddressID as integer,",
				"          ShipToAddressID as integer,",
				"          ShipMethodID as integer,",
				"          CreditCardID as integer,",
				"          CreditCardApprovalCode as string,",
				"          CurrencyRateID as integer,",
				"          SubTotal as decimal(19,4),",
				"          TaxAmt as decimal(19,4),",
				"          Freight as decimal(19,4),",
				"          TotalDue as decimal(19,4),",
				"          Comment as string,",
				"          rowguid as string,",
				"          ModifiedDate as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> SOH",
				"source(output(",
				"          SalesOrderID as integer,",
				"          SalesOrderDetailID as integer,",
				"          CarrierTrackingNumber as string,",
				"          OrderQty as integer,",
				"          ProductID as integer,",
				"          SpecialOfferID as integer,",
				"          UnitPrice as decimal(19,4),",
				"          UnitPriceDiscount as decimal(19,4),",
				"          LineTotal as decimal(38,6),",
				"          rowguid as string,",
				"          ModifiedDate as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> SOD",
				"source(output(",
				"          CustomerKey as integer,",
				"          CustomerID as integer,",
				"          PersonID as integer,",
				"          StoreID as integer,",
				"          TerritoryID as integer,",
				"          CustomerType as string,",
				"          FirstName as string,",
				"          MiddleName as string,",
				"          LastName as string,",
				"          age as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> customer",
				"source(output(",
				"          ProductKey as integer,",
				"          ProductID as integer,",
				"          ProductName as string,",
				"          ProductNumber as string,",
				"          Color_Imputed as string,",
				"          StandardCost as decimal(19,4),",
				"          ListPrice as decimal(19,4),",
				"          ProductSubcategoryID as integer,",
				"          ProductSubcategoryName as string,",
				"          ProductCategoryID as integer,",
				"          ProductCategoryName as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> product",
				"source(output(",
				"          DateKey as integer,",
				"          FullDate as date,",
				"          DayNumberOfMonth as integer,",
				"          MonthNumber as integer,",
				"          MonthName as string,",
				"          QuarterNumber as integer,",
				"          YearNumber as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> date",
				"source(output(",
				"          TerritoryKey as integer,",
				"          TerritoryID as integer,",
				"          TerritoryName as string,",
				"          CountryRegionCode as string,",
				"          TerritoryGroup as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> territoryu",
				"SOH, SOD join(SOH@SalesOrderID == SOD@SalesOrderID,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"lookup1 derive(FoundCustomer = !isNull(CustomerKey),",
				"          OrderDateKey = toInteger(toString(OrderDate, 'yyyyMMdd'))) ~> derivedColumn1",
				"join1, customer lookup(SOH@CustomerID == customer@CustomerID,",
				"     multiple: true,",
				"     broadcast: 'auto')~> lookup1",
				"derivedColumn1 split(FoundCustomer,",
				"     !FoundCustomer,",
				"     disjoint: false) ~> split1@(ValidCustomerRows, MissingCustomerRows)",
				"jointerritory select(mapColumn(",
				"          SalesOrderID = split1@ValidCustomerRows@SalesOrderID,",
				"          SalesOrderDetailID,",
				"          DateKey,",
				"          CustomerKey = customer@CustomerKey,",
				"          ProductKey,",
				"          OrderQty,",
				"          UnitPrice,",
				"          UnitPriceDiscount,",
				"          LineTotal,",
				"          TerritoryID = customer@TerritoryID",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"split1@MissingCustomerRows select(mapColumn(",
				"          SalesOrderID = split1@MissingCustomerRows@SalesOrderID,",
				"          RevisionNumber,",
				"          OrderDate,",
				"          DueDate,",
				"          ShipDate,",
				"          Status,",
				"          OnlineOrderFlag,",
				"          SalesOrderNumber,",
				"          PurchaseOrderNumber,",
				"          AccountNumber,",
				"          CustomerID = split1@MissingCustomerRows@CustomerID,",
				"          SalesPersonID,",
				"          TerritoryID = split1@MissingCustomerRows@TerritoryID,",
				"          BillToAddressID,",
				"          ShipToAddressID,",
				"          ShipMethodID,",
				"          CreditCardID,",
				"          CreditCardApprovalCode,",
				"          CurrencyRateID,",
				"          SubTotal,",
				"          TaxAmt,",
				"          Freight,",
				"          TotalDue,",
				"          Comment,",
				"          rowguid = split1@MissingCustomerRows@rowguid,",
				"          ModifiedDate = split1@MissingCustomerRows@ModifiedDate,",
				"          SalesOrderID = split1@MissingCustomerRows@SalesOrderID,",
				"          SalesOrderDetailID,",
				"          CarrierTrackingNumber,",
				"          OrderQty,",
				"          ProductID,",
				"          SpecialOfferID,",
				"          UnitPrice,",
				"          UnitPriceDiscount,",
				"          LineTotal,",
				"          rowguid = split1@MissingCustomerRows@rowguid,",
				"          ModifiedDate = split1@MissingCustomerRows@ModifiedDate,",
				"          CustomerKey,",
				"          CustomerID = split1@MissingCustomerRows@CustomerID,",
				"          PersonID,",
				"          StoreID,",
				"          TerritoryID = split1@MissingCustomerRows@TerritoryID,",
				"          CustomerType,",
				"          FirstName,",
				"          MiddleName,",
				"          LastName,",
				"          age,",
				"          FoundCustomer",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"split1@ValidCustomerRows, customer join(split1@ValidCustomerRows@CustomerID == customer@CustomerID,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'right')~> joincustomer",
				"joincustomer, product join(split1@ValidCustomerRows@ProductID == product@ProductID,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinprodcut",
				"joinprodcut, date join(OrderDateKey == DateKey,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joindate",
				"joindate, territoryu join(customer@TerritoryID == territoryu@TerritoryID,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> jointerritory",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          SalesKey as long,",
				"          SalesOrderID as integer,",
				"          SalesOrderDetailID as integer,",
				"          OrderDateKey as integer,",
				"          CustomerKey as integer,",
				"          ProductKey as integer,",
				"          TerritoryKey as integer,",
				"          OrderQty as integer,",
				"          UnitPrice as decimal(19,4),",
				"          UnitPriceDiscount as decimal(19,4),",
				"          LineTotal as decimal(19,4)",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     truncate:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          SalesOrderID,",
				"          SalesOrderDetailID,",
				"          OrderQty,",
				"          UnitPrice,",
				"          UnitPriceDiscount,",
				"          LineTotal,",
				"          CustomerKey,",
				"          OrderDateKey = DateKey,",
				"          ProductKey",
				"     )) ~> sink1",
				"select2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          SalesOrderID as integer,",
				"          SalesOrderDetailID as integer,",
				"          CustomerID as integer,",
				"          ErrorDescription as string,",
				"          ErrorDate as timestamp",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink2"
			]
		}
	}
}